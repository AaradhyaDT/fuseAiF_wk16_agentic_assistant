# ==============================================================================
# WK15 AI Assistant Configuration Template (.env.example)
# Copy this file to .env and adjust the values as needed.
# ==============================================================================

# --- Application ---
APP_NAME=wk15-assistant

# --- Primary Cloud Provider: Google Gemini (OpenAI-compatible endpoint) ---
# Required for Gemini to be active. If empty, Gemini is automatically disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Local vLLM Server (see Dockerfile.vllm / compose profile "local") ---
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=qwen2.5-1.5b-instruct
VLLM_API_KEY=EMPTY

# --- Local Fallback Provider: Ollama (OpenAI-compatible endpoint) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_API_KEY=ollama

# --- Provider Fallback Order ---
# Comma-separated list of active providers in order of fallback priority.
# Options: gemini, vllm, ollama (e.g., "gemini,ollama" or "ollama")
PROVIDER_ORDER=gemini,vllm,ollama

# --- Generation Parameters ---
TEMPERATURE=0.2
TOP_P=0.9
MAX_OUTPUT_TOKENS=1024
REQUEST_TIMEOUT_S=90.0

# --- RAG & Vector Store (Qdrant) ---
# Leave QDRANT_URL empty to use local embedded on-disk Qdrant at QDRANT_PATH.
# Set QDRANT_URL (e.g., http://localhost:6333 or http://qdrant:6333) for server mode.
QDRANT_URL=
QDRANT_PATH=data/qdrant
COLLECTION_NAME=wk15_kb
DATA_DOCS_DIR=data/docs
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=150
TOP_K=4

# --- Reliability & Resilience ---
RETRY_ATTEMPTS=3
RETRY_BACKOFF_S=0.5
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RESET_TIMEOUT_S=30.0
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=20

# --- Caching ---
CACHE_TTL_S=300
CACHE_MAX_ITEMS=512

# --- W16 Agentic Loop ---
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS_PER_ITER=4
AGENT_MAX_TOTAL_TOKENS=60000
AGENT_TOOL_TIMEOUT_S=10.0
AGENT_MAX_VERIFICATION_RETRIES=2
AGENT_ENABLE_CLEARING=true
AGENT_KEEP_LAST_TOOL_ROUNDS=1
AGENT_RETRIEVAL_K=4
AGENT_MIN_RELEVANCE=0.15
AGENT_SNIPPET_CHARS=600
AGENT_NOTES_MAX_CHARS=1500
AGENT_PROMPT_VERSION=v1
AGENT_FAULT_MODE=
SKILLS_DIR=skills
